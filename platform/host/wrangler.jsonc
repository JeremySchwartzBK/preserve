// Hosts the copy runner on Cloudflare Containers (decided 2026-10-18). Deploy from this folder:
//   npx wrangler@4.151.1 deploy
// Secrets (npx wrangler secret put <NAME>): DATABASE_URL (the runner's database role), CLOUDFLARE_API_TOKEN (R2 read and
// write for copies and captures), WAKE_SECRET (shared with the database trigger that wakes the runner).
{
  "name": "preserve-runner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Runner",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      // 4 vCPU / 12 GiB / 20 GB: two copy jobs at a time (RUNNER_SLOTS=2 in the image).
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "Runner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Runner"] }],
  // The safety net: once a minute, start the runner if there's work it hasn't picked up.
  "triggers": { "crons": ["* * * * *"] }
}
